    "pixi.js": "^7.4.2",
    "push": "^0.1.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.40.0",
    "@vitejs/plugin-basic-ssl": "^1.0.2",
    "canvas": "^3.2.1",
    "eslint": "^8.55.0",
    "jsdom": "^27.0.1",
    "pngjs": "^7.0.0",
    "prettier": "^3.1.1",
    "vite": "^5.0.8",
    "vite-plugin-pwa": "^0.17.4",
    "vitest": "^1.1.0"
