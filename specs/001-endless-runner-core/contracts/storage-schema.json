{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Endless Runner Storage Schema",
  "description": "IndexedDB schema contracts for game data persistence",
  "version": "1.0.0",
  "definitions": {
    "PlayerProfile": {
      "type": "object",
      "required": [
        "id",
        "highScore",
        "totalCoins",
        "lifetimeCoins",
        "gamesPlayed",
        "totalDistance",
        "totalJumps",
        "currentStreak",
        "lastPlayDate",
        "createdAt",
        "updatedAt"
      ],
      "properties": {
        "id": {
          "type": "string",
          "format": "uuid",
          "description": "Unique player identifier"
        },
        "highScore": {
          "type": "integer",
          "minimum": 0,
          "description": "Best distance score achieved"
        },
        "totalCoins": {
          "type": "integer",
          "minimum": 0,
          "description": "Current coin balance"
        },
        "lifetimeCoins": {
          "type": "integer",
          "minimum": 0,
          "description": "Total coins earned (monotonic)"
        },
        "gamesPlayed": {
          "type": "integer",
          "minimum": 0,
          "description": "Total game sessions"
        },
        "totalDistance": {
          "type": "integer",
          "minimum": 0,
          "description": "Cumulative distance across all games"
        },
        "totalJumps": {
          "type": "integer",
          "minimum": 0,
          "description": "Lifetime jump count"
        },
        "selectedSkin": {
          "type": ["string", "null"],
          "description": "Currently equipped character skin ID"
        },
        "currentStreak": {
          "type": "integer",
          "minimum": 0,
          "description": "Consecutive days with completed games"
        },
        "lastPlayDate": {
          "type": "string",
          "format": "date-time",
          "description": "Last calendar day player completed a game"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Account creation timestamp"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Last profile modification timestamp"
        }
      },
      "additionalProperties": false
    },
    "CosmeticItem": {
      "type": "object",
      "required": [
        "id",
        "name",
        "category",
        "rarity",
        "coinPrice",
        "assetPath",
        "isUnlocked"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z_]+$",
          "description": "Item identifier (e.g., skin_ninja_cat)"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 50,
          "description": "Display name"
        },
        "description": {
          "type": "string",
          "maxLength": 200,
          "description": "Flavor text"
        },
        "category": {
          "type": "string",
          "enum": ["skin", "trail", "theme"],
          "description": "Item type"
        },
        "rarity": {
          "type": "string",
          "enum": ["common", "rare", "epic", "legendary"],
          "description": "Visual rarity indicator"
        },
        "coinPrice": {
          "type": "integer",
          "minimum": 0,
          "description": "Cost in coins (0 = starter item)"
        },
        "assetPath": {
          "type": "string",
          "pattern": "^sprites/.+\\.(png|jpg)$",
          "description": "Path to sprite/texture file"
        },
        "unlockRequirement": {
          "type": "string",
          "description": "Special unlock condition (optional)"
        },
        "isUnlocked": {
          "type": "boolean",
          "description": "Player ownership status"
        },
        "unlockedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Unlock timestamp"
        }
      },
      "additionalProperties": false
    },
    "DailyChallenge": {
      "type": "object",
      "required": [
        "id",
        "date",
        "type",
        "targetValue",
        "currentValue",
        "rewardCoins",
        "isCompleted",
        "expiresAt"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^challenge_\\d{4}-\\d{2}-\\d{2}$",
          "description": "Challenge identifier (date-based)"
        },
        "date": {
          "type": "string",
          "format": "date",
          "description": "Challenge valid date"
        },
        "type": {
          "type": "string",
          "enum": ["jump_count", "coin_collect", "distance", "perfect_run"],
          "description": "Objective type"
        },
        "targetValue": {
          "type": "integer",
          "minimum": 1,
          "description": "Goal to achieve"
        },
        "currentValue": {
          "type": "integer",
          "minimum": 0,
          "description": "Player progress"
        },
        "rewardCoins": {
          "type": "integer",
          "minimum": 1,
          "description": "Coin reward for completion"
        },
        "isCompleted": {
          "type": "boolean",
          "description": "Completion status"
        },
        "completedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Completion timestamp"
        },
        "expiresAt": {
          "type": "string",
          "format": "date-time",
          "description": "Challenge expiration"
        }
      },
      "additionalProperties": false
    },
    "Achievement": {
      "type": "object",
      "required": [
        "id",
        "name",
        "description",
        "threshold",
        "type",
        "isUnlocked",
        "iconPath"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z_0-9]+$",
          "description": "Achievement identifier"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 50,
          "description": "Display name"
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200,
          "description": "Achievement criteria"
        },
        "threshold": {
          "type": "integer",
          "minimum": 1,
          "description": "Score/stat requirement"
        },
        "type": {
          "type": "string",
          "enum": ["score", "games", "coins", "streak"],
          "description": "Metric type"
        },
        "isUnlocked": {
          "type": "boolean",
          "description": "Unlock status"
        },
        "unlockedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Unlock timestamp"
        },
        "iconPath": {
          "type": "string",
          "pattern": "^sprites/badges/.+\\.png$",
          "description": "Badge sprite path"
        }
      },
      "additionalProperties": false
    },
    "PurchaseTransaction": {
      "type": "object",
      "required": [
        "transactionId",
        "platform",
        "bundleId",
        "coinAmount",
        "priceUSD",
        "status",
        "createdAt"
      ],
      "properties": {
        "transactionId": {
          "type": "string",
          "minLength": 1,
          "description": "Platform transaction ID (unique)"
        },
        "platform": {
          "type": "string",
          "enum": ["apple", "google", "stripe"],
          "description": "Payment provider"
        },
        "bundleId": {
          "type": "string",
          "enum": ["coins_500", "coins_3000", "coins_7500"],
          "description": "Product identifier"
        },
        "coinAmount": {
          "type": "integer",
          "minimum": 1,
          "description": "Coins purchased"
        },
        "priceUSD": {
          "type": "number",
          "minimum": 0.01,
          "description": "Price in USD"
        },
        "status": {
          "type": "string",
          "enum": ["pending", "completed", "failed", "refunded"],
          "description": "Transaction state"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Purchase initiation time"
        },
        "completedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Fulfillment timestamp"
        },
        "receipt": {
          "type": "string",
          "description": "Platform receipt data (base64)"
        }
      },
      "additionalProperties": false
    }
  },
  "storageContract": {
    "database": {
      "name": "EndlessRunnerDB",
      "version": 1,
      "description": "Primary IndexedDB database for game data"
    },
    "objectStores": [
      {
        "name": "playerProfile",
        "keyPath": "id",
        "autoIncrement": false,
        "schema": {
          "$ref": "#/definitions/PlayerProfile"
        },
        "indexes": [],
        "notes": "Singleton store - only one record exists"
      },
      {
        "name": "cosmetics",
        "keyPath": "id",
        "autoIncrement": false,
        "schema": {
          "$ref": "#/definitions/CosmeticItem"
        },
        "indexes": [
          {
            "name": "category",
            "keyPath": "category",
            "unique": false,
            "description": "Filter items by type (skin/trail/theme)"
          },
          {
            "name": "isUnlocked",
            "keyPath": "isUnlocked",
            "unique": false,
            "description": "Query owned vs. available items"
          }
        ],
        "notes": "Preloaded catalog, ~50 items expected"
      },
      {
        "name": "challenges",
        "keyPath": "id",
        "autoIncrement": false,
        "schema": {
          "$ref": "#/definitions/DailyChallenge"
        },
        "indexes": [
          {
            "name": "date",
            "keyPath": "date",
            "unique": true,
            "description": "Ensure one challenge per day"
          },
          {
            "name": "expiresAt",
            "keyPath": "expiresAt",
            "unique": false,
            "description": "Cleanup expired challenges"
          }
        ],
        "notes": "Auto-purge entries older than 7 days"
      },
      {
        "name": "achievements",
        "keyPath": "id",
        "autoIncrement": false,
        "schema": {
          "$ref": "#/definitions/Achievement"
        },
        "indexes": [
          {
            "name": "type",
            "keyPath": "type",
            "unique": false,
            "description": "Group by metric type"
          },
          {
            "name": "isUnlocked",
            "keyPath": "isUnlocked",
            "unique": false,
            "description": "Filter earned vs. pending"
          }
        ],
        "notes": "Preloaded milestones, ~20 items expected"
      },
      {
        "name": "transactions",
        "keyPath": "transactionId",
        "autoIncrement": false,
        "schema": {
          "$ref": "#/definitions/PurchaseTransaction"
        },
        "indexes": [
          {
            "name": "platform",
            "keyPath": "platform",
            "unique": false,
            "description": "Filter by payment provider"
          },
          {
            "name": "status",
            "keyPath": "status",
            "unique": false,
            "description": "Query pending/failed transactions"
          },
          {
            "name": "createdAt",
            "keyPath": "createdAt",
            "unique": false,
            "description": "Time-based queries for audits"
          }
        ],
        "notes": "Retain last 100 transactions, archive older"
      }
    ]
  },
  "fallbackStorage": {
    "description": "localStorage backup for IndexedDB unavailability",
    "keys": [
      {
        "key": "er_playerProfile",
        "schema": {
          "$ref": "#/definitions/PlayerProfile"
        },
        "serialization": "JSON.stringify"
      },
      {
        "key": "er_cosmetics",
        "schema": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/CosmeticItem"
          }
        },
        "serialization": "JSON.stringify"
      },
      {
        "key": "er_challenges",
        "schema": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/DailyChallenge"
          }
        },
        "serialization": "JSON.stringify"
      }
    ],
    "limitations": "5-10MB total storage, synchronous API, string-only values"
  }
}
